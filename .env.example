# Copy to .env and change the passwords. .env is git-ignored; never commit it.

# RustFS (S3-compatible object store)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-s3-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Postgres (serving database for Gold)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=warehouse
# Change the host port if another Postgres already listens on 5432.
POSTGRES_PORT=5432
# Schema that receives the Gold star schema (src/publish_gold_to_postgres.py).
POSTGRES_SCHEMA=gold
